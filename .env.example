# Copy to .env for local development (`npx netlify dev`). In production, set the
# same four variables in Netlify → Site configuration → Environment variables.

# OAuth Client ID (public; the browser and the function both use it).
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Service account that writes to the sheet (secret).
GOOGLE_SERVICE_ACCOUNT_EMAIL=genomia-sheets@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
